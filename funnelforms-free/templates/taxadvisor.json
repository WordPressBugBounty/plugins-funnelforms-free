ue,"props":{"html":{"en_US":"I agree that my details are used to answer my request. More in the <a href=\"%privacy_url%\" target=\"_blank\" rel=\"noopener\">privacy policy</a>.","de_DE":"Ich bin einverstanden, dass meine Angaben zur Bearbeitung meiner Anfrage verwendet werden. Mehr dazu in der <a href=\"%privacy_url%\" target=\"_blank\" rel=\"noopener\">Datenschutzerklärung</a>.","de_DE_formal":"Ich bin einverstanden, dass meine Angaben zur Bearbeitung meiner Anfrage verwendet werden. Mehr dazu in der <a href=\"%privacy_url%\" target=\"_blank\" rel=\"noopener\">Datenschutzerklärung</a>.","es_ES":"Acepto que mis datos se utilicen para responder a mi solicitud. Más información en la <a href=\"%privacy_url%\" target=\"_blank\" rel=\"noopener\">política de privacidad</a>.","fr_FR":"J’accepte que mes données soient utilisées pour traiter ma demande. Plus d’informations dans la <a href=\"%privacy_url%\" target=\"_blank\" rel=\"noopener\">politique de confidentialité</a>.","it_IT":"Acconsento all’uso dei miei dati per rispondere alla mia richiesta. Maggiori informazioni nell’<a href=\"%privacy_url%\" target=\"_blank\" rel=\"noopener\">informativa sulla privacy</a>."}}}],"showBottomBar":true,"layout":{"columns":{"desktop":2,"mobile":1}}},{"id":"end","type":"end","success":{"show":true,"heading":{"en_US":"Thank you, {{field:name}}!","de_DE":"Vielen Dank, {{field:name}}!","de_DE_formal":"Vielen Dank, {{field:name}}!","es_ES":"¡Gracias, {{field:name}}!","fr_FR":"Merci, {{field:name}} !","it_IT":"Grazie, {{field:name}}!"},"text":{"en_US":"<p>Your request has arrived. We will call or e-mail you shortly to arrange a time that suits you.</p><h3>What happens now?</h3><ol><li>We read your answers.</li><li>We get in touch within one working day to find a time.</li><li>In a free first conversation we talk about your options.</li></ol>","de_DE":"<p>Deine Anfrage ist bei uns angekommen. Wir melden uns in Kürze, um einen passenden Termin zu vereinbaren.</p><h3>Was passiert jetzt?</h3><ol><li>Wir lesen deine Angaben.</li><li>Wir melden uns innerhalb eines Werktags für einen Termin.</li><li>Im kostenlosen Erstgespräch besprechen wir deine Möglichkeiten.</li></ol>","de_DE_formal":"<p>Ihre Anfrage ist bei uns angekommen. Wir melden uns in Kürze, um einen passenden Termin zu vereinbaren.</p><h3>Was passiert jetzt?</h3><ol><li>Wir lesen Ihre Angaben.</li><li>Wir melden uns innerhalb eines Werktags für einen Termin.</li><li>Im kostenlosen Erstgespräch besprechen wir Ihre Möglichkeiten.</li></ol>","es_ES":"<p>Hemos recibido tu solicitud. Te llamaremos o escribiremos en breve para acordar una cita.</p><h3>¿Qué pasa ahora?</h3><ol><li>Leemos tus respuestas.</li><li>Te contactamos en un día laborable para fijar una cita.</li><li>En una primera conversación gratuita vemos tus opciones.</li></ol>","fr_FR":"<p>Votre demande nous est bien parvenue. Nous vous contactons rapidement pour convenir d’un rendez-vous.</p><h3>Et maintenant ?</h3><ol><li>Nous lisons vos réponses.</li><li>Nous vous contactons sous un jour ouvré pour fixer un rendez-vous.</li><li>Lors d’un premier échange gratuit, nous voyons vos options.</li></ol>","it_IT":"<p>Abbiamo ricevuto la tua richiesta. Ti contatteremo a breve per fissare un appuntamento.</p><h3>E adesso?</h3><ol><li>Leggiamo le tue risposte.</li><li>Ti contattiamo entro un giorno lavorativo per fissare un appuntamento.</li><li>In un primo colloquio gratuito parliamo delle tue possibilità.</li></ol>"},"animation":"check","button":{"label":{"en_US":"Back to the website","de_DE":"Zurück zur Website","de_DE_formal":"Zurück zur Website","es_ES":"Volver a la web","fr_FR":"Retour au site","it_IT":"Torna al sito"},"url":{"en_US":"%home_url%","de_DE":"%home_url%","de_DE_formal":"%home_url%","es_ES":"%home_url%","fr_FR":"%home_url%","it_IT":"%home_url%"}}},"redirect":null}],"edges":[{"id":"e_client_1","from":"client","to":"business","when":{"field":"q_client","op":"selected","value":"o_client_freelance"}},{"id":"e_client_2","from":"client",