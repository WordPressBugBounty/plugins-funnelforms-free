con attenzione e ti risponderemo entro pochi giorni.</p><h3>E adesso?</h3><ol><li>Leggiamo con attenzione la tua candidatura.</li><li>Ti rispondiamo entro pochi giorni.</li><li>Ci conosciamo con una breve telefonata o di persona.</li></ol>"},"animation":"confetti","button":{"label":{"en_US":"Back to the website","de_DE":"Zurück zur Website","de_DE_formal":"Zurück zur Website","es_ES":"Volver a la web","fr_FR":"Retour au site","it_IT":"Torna al sito"},"url":{"en_US":"%home_url%","de_DE":"%home_url%","de_DE_formal":"%home_url%","es_ES":"%home_url%","fr_FR":"%home_url%","it_IT":"%home_url%"}}},"redirect":null}],"edges":[{"id":"e_trade_1","from":"trade","to":"qualification","default":true},{"id":"e_qualification_1","from":"qualification","to":"years","default":true},{"id":"e_years_1","from":"years","to":"licence","default":true},{"id":"e_licence_1","from":"licence","to":"matters","default":true},{"id":"e_matters_1","from":"matters","to":"start","default":true},{"id":"e_start_1","from":"start","to":"contact","default":true},{"id":"e_contact_1","from":"contact","to":"end","default":true}],"calculations":[],"actions":[{"id":"a_owner","on":"submit","kind":"email","config":{"to":{"en_US":"","de_DE":"","de_DE_formal":"","es_ES":"","fr_FR":"","it_IT":""},"cc":{"en_US":"","de_DE":"","de_DE_formal":"","es_ES":"","fr_FR":"","it_IT":""},"bcc":{"en_US":"","de_DE":"","de_DE_formal":"","es_ES":"","fr_FR":"","it_IT":""},"from":{"en_US":"","de_DE":"","de_DE_formal":"","es_ES":"","fr_FR":"","it_IT":""},"fromName":{"en_US":"","de_DE":"","de_DE_formal":"","es_ES":"","fr_FR":"","it_IT":""},"replyTo":{"en_US":"{{field:email}}","de_DE":"{{field:email}}","de_DE_formal":"{{field:email}}","es_ES":"{{field:email}}","fr_FR":"{{field:email}}","it_IT":"{{field:email}}"},"subject":{"en_US":"New trades application: {{field:trade}} · {{field:qualification}} · {{field:start}}","de_DE":"Neue Bewerbung Handwerk: {{field:trade}} · {{field:qualification}} · {{field:start}}","de_DE_formal":"Neue Bewerbung H