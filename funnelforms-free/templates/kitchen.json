ahl","es_ES":"Código postal","fr_FR":"Code postal","it_IT":"CAP"},"required":true,"props":{"placeholder":{"en_US":"Where is the project?","de_DE":"Wo liegt das Objekt?","de_DE_formal":"Wo liegt das Objekt?","es_ES":"¿Dónde está el proyecto?","fr_FR":"Où se situe le projet ?","it_IT":"Dove si trova il progetto?"},"icon":"lucide:map-pin","maxLength":10}},{"id":"c_slot","type":"select","key":"slot","label":{"en_US":"When suits you best?","de_DE":"Wann passt es dir am besten?","de_DE_formal":"Wann passt es Ihnen am besten?","es_ES":"¿Cuándo te va mejor?","fr_FR":"Quand cela vous convient-il le mieux ?","it_IT":"Quando ti è più comodo?"},"required":false,"props":{"placeholder":{"en_US":"Please choose","de_DE":"Bitte wählen","de_DE_formal":"Bitte wählen","es_ES":"Elige una opción","fr_FR":"Veuillez choisir","it_IT":"Scegli"},"options":[{"id":"morning","label":{"en_US":"Weekdays, mornings","de_DE":"Werktags vormittags","de_DE_formal":"Werktags vormittags","es_ES":"Entre semana, por la mañana","fr_FR":"En semaine, le matin","it_IT":"Giorni feriali, mattina"}},{"id":"afternoon","label":{"en_US":"Weekdays, afternoons","de_DE":"Werktags nachmittags","de_DE_formal":"Werktags nachmittags","es_ES":"Entre semana, por la tarde","fr_FR":"En semaine, l’après-midi","it_IT":"Giorni feriali, pomeriggio"}},{"id":"evening","label":{"en_US":"Weekdays, evenings","de_DE":"Werktags abends","de_DE_formal":"Werktags abends","es_ES":"Entre semana, por la noche","fr_FR":"En semaine, en soirée","it_IT":"Giorni feriali, sera"}},{"id":"saturday","label":{"en_US":"Saturday","de_DE":"Samstag","de_DE_formal":"Samstag","es_ES":"Sábado","fr_FR":"Samedi","it_IT":"Sabato"}}]}},{"id":"c_consent","type":"consent","key":"consent","label":{"en_US":"","de_DE":"","de_DE_formal":"","es_ES":"","fr_FR":"","it_IT":""},"required":true,"props":{"html":{"en_US":"I agree that my details are used to arrange my appointment. More in the <a href=\"%privacy_url%\" target=\"_blank\" rel=\"noopener\">privacy policy</a>.","de_DE":"Ich bin einverstanden, dass meine Angaben zur Vereinbarung meines Termins verwendet werden. Mehr dazu in der <a href=\"%privacy_url%\" target=\"_blank\" rel=\"noopener\">Datenschutzerklärung</a>.","de_DE_formal":"Ich bin einverstanden, dass meine Angaben zur Vereinbarung meines Termins verwendet werden. Mehr dazu in der <a href=\"%privacy_url%\" target=\"_blank\" rel=\"noopener\">Datenschutzerklärung</a>.","es_ES":"Acepto que mis datos se utilicen para organizar mi cita. Más información en la <a href=\"%privacy_url%\" target=\"_blank\" rel=\"noopener\">política de privacidad</a>.","fr_FR":"J’accepte que mes données soient utilisées pour organiser mon rendez-vous. Plus d’informations dans la <a href=\"%privacy_url%\" target=\"_blank\" rel=\"noopener\">politique de confidentialité</a>.","it_IT":"Acconsento all’uso dei miei dati per organizzare il mio appuntamento. Maggiori informazioni nell’<a href=\"%privacy_url%\" target=\"_blank\" rel=\"noopener\">informativa sulla privacy</a>."}}}],"showBottomBar":true,"layout":{"columns":{"desktop":2,"mobile":1}}},{"id":"end","type":"end","success":{"show":true,"heading":{"en_US":"Thank you, {{field:name}}!","de_DE":"Vielen Dank, {{field:name}}!","de_DE_formal":"Vielen Dank, {{field:name}}!","es_ES":"¡Gracias, {{field:name}}!","fr_FR":"Merci, {{field:name}} !","it_IT":"Grazie, {{field:name}}!"},"text":{"en_US":"<p>We are looking forward to planning your kitchen. We will call you shortly to find a date for your appointment.</p><h3>What happens now?</h3><ol><li>We read your wishes.</li><li>We call you within one working day to fix your planning appointment.</li><li>In the studio we plan your kitchen in 3D, free of charge. Bring a floor plan or measurements.</li></ol>","de_DE":"<p>Wir freuen uns darauf, deine Küche zu planen. Wir melden uns in Kürze, um einen Termin zu finden.</p><h3>Was passiert jetzt?</h3><ol><li>Wir lesen deine Wünsche.</li><li>Wir rufen innerhalb eines Werktags an und vereinbaren deinen Planungstermin.</li><li>Im Studio planen wir deine Küche kostenlos in 3D. Grundriss oder Maße gern mitbringen.</li></ol>","de_DE_formal":"<p>Wir freuen uns darauf, Ihre Küche zu planen. Wir melden uns in Kürze, um einen Termin zu finden.</p><h3>Was passiert jetzt?</h3><ol><li>Wir lesen Ihre Wünsche.</li><li>Wir rufen innerhalb eines Werktags an und vereinbaren Ihren Planungstermin.</li><li>Im Studio planen wir Ihre Küche kostenlos in 3D. Grundriss oder Maße gern mitbringen.</li></ol>","es_ES":"<p>Nos alegra diseñar tu cocina. Te llamaremos en breve para fijar una cita.</p><h3>¿Qué pasa ahora?</h3><ol><li>Leemos tus deseos.</li><li>Te llamamos en un día laborable para fijar la cita.</li><li>En el estudio diseñamos tu cocina en 3D gratis. Trae un plano o medidas.</li></ol>","fr_FR":"<p>Nous avons hâte de concevoir votre cuisine. Nous vous appelons rapidement pour fixer un rendez-vous.</p><h3>Et maintenant ?</h3><ol><li>Nous lisons vos souhaits.</li><li>Nous vous appelons sous un jour ouvré pour fixer le rendez-vous.</li><li>Au studio, nous concevons votre cuisine en 3D gratuitement. Apportez un plan ou vos mesures.</li></ol>","it_IT":"<p>Non vediamo l’ora di progettare la tua cucina. Ti chiameremo a breve per fissare un appuntamento.</p><h3>E adesso?</h3><ol><li>Leggiamo i tuoi desideri.</li><li>Ti chiamiamo entro un giorno lavorativo per fissare l’appuntamento.</li><li>In studio progettiamo la tua cucina in 3D gratis. Porta una pianta o le misure.</li></ol>"},"animation":"check","button":{"label":{"en_US":"Back to the website","de_DE":"Zurück zur Website","de_DE_formal":"Zurück zur Website","es_ES":"Volver a la web","fr_FR":"Retour au site","it_IT":"Torna al sito"},"url":{"en_US":"%home_url%","de_DE":"%home_url%","de_DE_formal":"%home_url%","es_ES":"%home_url%","fr_FR":"%home_url%","it_IT":"%home_url%"}}},"redirect":null}],"edges":[{"id":"e_project_1","from":"project","to":"appliances","when":{"field":"q_project","op":"selected","value":"o_project_rework"}},{"id":"e_project_2","from":"pr